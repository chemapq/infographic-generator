# Copia este archivo a `.env` y ajusta los valores.

# Puerto del servidor de la API / interfaz
PORT=3000

# Entorno de ejecución: development | production
NODE_ENV=development

# Carpeta donde se persisten los jobs (imagen, HTML, capturas, diffs, coste)
OUTPUT_DIR=output

# --- Anthropic ---
# Clave de API. Si se omite, el SDK resuelve credenciales del entorno
# (ANTHROPIC_AUTH_TOKEN o un perfil de `ant auth login`).
ANTHROPIC_API_KEY=

# Modelo de visión/generación
ANTHROPIC_MODEL=claude-opus-4-8

# --- Login ---
# Contraseña de acceso. Vacía (lo normal en local) = la app se abre directamente.
# Definirla activa la pantalla de login para toda la herramienta.
# Con NODE_ENV=production es obligatoria: sin ella el servidor no arranca.
AUTH_PASSWORD=

# Clave con la que se firman las sesiones. Si se deja vacía se genera una nueva
# en cada arranque, y las sesiones abiertas caducan al reiniciar.
AUTH_SECRET=

# Duración de la sesión, en horas
AUTH_SESSION_HOURS=12

# --- Pipeline ---
# Techo duro de pasadas de refinado por job
MAX_PASSES=5

# % de similitud pixelmatch para considerar el resultado "suficiente"
TARGET_SCORE=97

# --- Galería ---
# all (por defecto) = la galería lista todos los jobs de la instalación.
# owner = filtra por la cookie ig_owner (los jobs sin dueño se siguen mostrando).
GALLERY_SCOPE=all

# Nº de tarjetas por página
GALLERY_PAGE_SIZE=24

# Ancho (px) de las miniaturas generadas para la galería
THUMB_WIDTH=480
