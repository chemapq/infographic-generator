# Copia este archivo a `.env` y ajusta los valores.

# Puerto del servidor de la API / interfaz
PORT=3000

# Entorno de ejecución: development | production
NODE_ENV=development

# Carpeta donde se persisten los jobs (imagen, HTML, capturas, diffs, coste)
OUTPUT_DIR=output

# --- Anthropic ---
# Clave de API. Si se omite, el SDK resuelve credenciales del entorno
# (ANTHROPIC_AUTH_TOKEN o un perfil de `ant auth login`).
ANTHROPIC_API_KEY=

# Modelo de visión/generación
ANTHROPIC_MODEL=claude-opus-4-8

# --- Login ---
# Contraseña de acceso. Vacía (lo normal en local) = la app se abre directamente.
# Definirla activa la pantalla de login para toda la herramienta.
# Con NODE_ENV=production es obligatoria: sin ella el servidor no arranca.
AUTH_PASSWORD=

# Clave con la que se firman las sesiones. Si se deja vacía se genera una nueva
# en cada arranque, y las sesiones abiertas caducan al reiniciar.
AUTH_SECRET=

# Duración de la sesión, en horas
AUTH_SESSION_HOURS=12

# --- Iframe del plugin de Moodle ---
# El plugin no reimplementa nada: incrusta esta misma app y le pasa la
# identidad del usuario en un ticket firmado. Ver src/services/embed.ts y
# moodle-plugin/local/awakeinfographic/README.md.

# Secreto compartido con el plugin: tiene que ser EXACTAMENTE el mismo valor
# que el ajuste «Secreto compartido con el motor» en Moodle. Vacío = no se
# aceptan tickets y GET /embed responde 404.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EMBED_SECRET=

# Orígenes que pueden meter la app en un iframe, separados por comas
# (p. ej. https://moodle.ejemplo.com). Vacío = no se manda ninguna CSP, que
# es lo normal en local. Restringe, no habilita: sin esto el iframe también
# funciona, porque el motor no manda X-Frame-Options.
EMBED_ALLOWED_ORIGINS=

# Duración de la sesión que abre un ticket, en horas. El token viaja en la
# querystring (la app lo necesita en <img src> y en las descargas), así que
# aparece en los logs de acceso: esta caducidad es lo que lo acota.
EMBED_SESSION_HOURS=12

# --- Pipeline ---
# Techo duro de pasadas de refinado por job
MAX_PASSES=5

# % de similitud pixelmatch para considerar el resultado "suficiente"
TARGET_SCORE=97

# --- Galería ---
# all (por defecto) = la galería lista todos los jobs de la instalación.
# owner = filtra por la cookie ig_owner (los jobs sin dueño se siguen mostrando).
GALLERY_SCOPE=all

# Nº de tarjetas por página
GALLERY_PAGE_SIZE=24

# Ancho (px) de las miniaturas generadas para la galería
THUMB_WIDTH=480

# --- API v1 (clientes servidor-a-servidor) ---
# Ver docs/openapi.yaml. El plugin de Moodle ya NO la usa: desde su 1.0.0
# incrusta la app y solo firma tickets (ver EMBED_SECRET arriba). Esto queda
# para integraciones propias que quieran generar sin interfaz.

# Claves bearer, formato "nombre:clave,nombre2:clave2". El nombre es el
# ownerId del job y lo único que se escribe en los logs. Vacío = /api/v1
# rechaza todo salvo /health.
API_KEYS=

# Jobs en cola (encolados + en curso) antes de que POST /api/v1/jobs
# devuelva 429 queue_full.
API_MAX_QUEUE_DEPTH=5

# Tope de jobs por clave y día natural (UTC) antes de 429 quota_exceeded.
API_DAILY_JOB_LIMIT=50

# Tope de ediciones (POST /api/v1/edit) por clave y día natural. Un orden de
# magnitud más barato que un job: no comparte cupo con API_DAILY_JOB_LIMIT.
API_DAILY_EDIT_LIMIT=500

# Ediciones en curso a la vez. No pasan por la cola en serie de los jobs;
# esto es solo para no reventar el límite de la API de Anthropic.
API_MAX_CONCURRENT_EDITS=4

# Antigüedad (días) a partir de la que se borra output/<jobId>.
# 0 (por defecto) = sin límite, no cambia el comportamiento actual.
RETENTION_DAYS=0

# false = sirve solo la API (sin estáticos, sin login, sin galería web, y sin
# /embed: el iframe de Moodle necesita la interfaz). Útil para un despliegue
# que solo alimenta integraciones servidor-a-servidor.
UI_ENABLED=true
