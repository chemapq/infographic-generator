{
  "name": "infographic-generator",
  "version": "0.1.0",
  "description": "API en TypeScript + Node para generar imágenes (infografías) con una interfaz web.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "job": "tsx src/cli.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "build:moodle": "node scripts/build-moodle.mjs",
    "format": "prettier --write ."
  },
  "keywords": [
    "infographic",
    "image-generation",
    "api",
    "typescript",
    "node"
  ],
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/sdk": "0.111.0",
    "express": "^5.1.0",
    "multer": "^2.2.0",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.61.1",
    "sharp": "^0.34.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.0.13",
    "@types/pixelmatch": "^5.2.6",
    "eslint": "^9.31.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.36.0"
  }
}
